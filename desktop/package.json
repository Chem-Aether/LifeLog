{
  "name": "lifelog-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "LifeLog desktop shell",
  "main": "main.cjs",
  "scripts": {
    "dev:web": "npm --prefix ../font run dev -- --host 127.0.0.1 --strictPort",
    "dev:app": "wait-on http://127.0.0.1:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:app\"",
    "start": "electron .",
    "build:web": "npm --prefix ../font run build",
    "dist:win": "npm run build:web && node verify-runtime.cjs && electron-builder --win portable"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.lifelog.desktop",
    "productName": "LifeLog",
    "directories": {
      "output": "release"
    },
    "artifactName": "LifeLog-${version}-portable.${ext}",
    "files": [
      "main.cjs",
      "config.json",
      "package.json"
    ],
    "extraResources": [
      { "from": "../font/dist", "to": "web" },
      {
        "from": "../javaserver/target",
        "to": "services/java",
        "filter": ["auth.jar", "bill.jar", "diary.jar", "travel.jar"]
      }
    ],
    "win": {
      "target": ["portable"]
    }
  }
}
